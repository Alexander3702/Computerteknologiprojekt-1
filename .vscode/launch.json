{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Main (TurtleBot3 Agent)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1",
                "ROS_DOMAIN_ID": "30"
            },
            "sudo": false
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Python: TurtleBot3 Obstacle Detection Module",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/turtlebot3_obstacle_detection.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONUNBUFFERED": "1",
                "ROS_DOMAIN_ID": "30"
            }
        }
    ]
}
